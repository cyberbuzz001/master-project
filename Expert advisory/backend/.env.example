APP_NAME="Expert Stocks Consultancy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

# ---- Platform -------------------------------------------------------------
# Demo mode shows is_demo records and seeds demo accounts. MUST be false in production.
DEMO_MODE=false
PLATFORM_DISPLAY_TIMEZONE=Asia/Kolkata
SECURITY_MAX_FAILED_LOGINS=5
SECURITY_LOCKOUT_BASE_MINUTES=15
SECURITY_LOCKOUT_MAX_MINUTES=1440
SECURITY_ENFORCE_STAFF_2FA=true
LEAD_DUPLICATE_WINDOW_DAYS=90

# First Super Admin (used once by `php artisan db:seed`). Leave the password empty
# locally to have one generated and printed; required in production. Remove after bootstrap.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_NAME="Super Admin"
INITIAL_SUPER_ADMIN_PASSWORD=

# ---- Security -------------------------------------------------------------
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
# Proxies allowed to set X-Forwarded-* (Nginx on the same host).
TRUSTED_PROXIES=127.0.0.1

# ---- Logging --------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Database -------------------------------------------------------------
# Local development uses SQLite. Production uses MySQL 8:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=expertstocks
# DB_USERNAME=app_rw
# DB_PASSWORD=
DB_CONNECTION=sqlite

# ---- Session / SPA auth -----------------------------------------------------
# The Next.js app and this API are served from the same origin (Nginx routes /api and /sanctum).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=esc_session
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

# ---- Queues, cache, storage ---------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# Production: QUEUE_CONNECTION=redis, CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail (Phase 7 adds provider abstraction) ---------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@expertstocks.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Next.js origin (public site, client portal, shared sign-in page)
FRONTEND_URL=http://localhost:3000

# ---- Client onboarding (Phase 3) ----------------------------------------------
# Where client documents live. Keep this on encrypted-at-rest storage; contents are
# additionally encrypted with APP_KEY when DOCUMENT_ENCRYPT_AT_REST is true.
DOCUMENT_DISK=local
DOCUMENT_ENCRYPT_AT_REST=true
DOCUMENT_MAX_SIZE_KB=10240
DOCUMENT_URL_TTL_MINUTES=5
# How long a risk profile stays valid before the client is asked to retake it.
RISK_PROFILE_VALID_DAYS=365
# Retention after the relationship ends — set from the firm's own records policy.
RETENTION_CLIENT_YEARS=5
RETENTION_CORRESPONDENCE_YEARS=5

# ---- Billing (Phase 4) ---------------------------------------------------------
BILLING_CURRENCY=INR
# Financial year start month for invoice/receipt numbering (India: April).
BILLING_FY_START_MONTH=4
BILLING_INVOICE_PREFIX=INV
BILLING_RECEIPT_PREFIX=RCP
BILLING_DUE_DAYS=7
# Confirm these against the firm's own registration before issuing invoices.
BILLING_DEFAULT_TAX_CODE=gst_18
BILLING_HOME_STATE=
# A manually recorded payment must be verified by a second person.
BILLING_SEPARATE_VERIFIER=true
BILLING_REQUIRE_PROOF=true
# Gateways are wired in Phase 4b; nothing is enabled by default.
CASHFREE_ENABLED=false
RAZORPAY_ENABLED=false

# Gateway credentials (each provider stays off until both its flag and its keys are set).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
