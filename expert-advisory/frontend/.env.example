# Laravel API origin used by Next.js rewrites (dev) and server-side fetches.
BACKEND_URL=http://127.0.0.1:8000
# Production: https://api.expertstocks.in
# Public canonical URL used in metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Must match SESSION_COOKIE in backend/.env. Used only for the optimistic redirect in src/proxy.ts.
SESSION_COOKIE_NAME=esc_session

# Required for Meta webhook signature verification (never use the verify token here).
ADVISORY_WHATSAPP_APP_SECRET=
# A private random token configured identically in the Meta webhook setup.
ADVISORY_WHATSAPP_WEBHOOK_SECRET=
# Only needed by remaining server-side template helpers. Set a supported version
# verified in your Meta app; template approval is specific to your WABA.
ADVISORY_WHATSAPP_META_TOKEN=
ADVISORY_WHATSAPP_PHONE_NUMBER_ID=
ADVISORY_WHATSAPP_GRAPH_VERSION=

# Optional server-side email helper; never commit credentials.
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=

# Optional broker market-data integration; never commit live credentials.
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_CLIENT_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=
FYERS_REDIRECT_URI=
