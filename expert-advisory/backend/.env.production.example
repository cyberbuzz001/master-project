APP_NAME="Expert Stocks Consultancy"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://expertstocks.in
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

# ---- Platform & Security ---------------------------------------------------
# Demo mode MUST be false in production (fences demo seeders and test rows)
DEMO_MODE=false
PLATFORM_DISPLAY_TIMEZONE=Asia/Kolkata
SECURITY_MAX_FAILED_LOGINS=5
SECURITY_LOCKOUT_BASE_MINUTES=15
SECURITY_LOCKOUT_MAX_MINUTES=1440
SECURITY_ENFORCE_STAFF_2FA=true
LEAD_DUPLICATE_WINDOW_DAYS=90

# Bootstrap Super Admin (Remove or comment out after initial bootstrap)
# INITIAL_SUPER_ADMIN_EMAIL=admin@expertstocks.in
# INITIAL_SUPER_ADMIN_NAME="Super Administrator"
# INITIAL_SUPER_ADMIN_PASSWORD="ChooseAStrong24CharacterPassword"

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12
# Trusted proxies for Cloudflare & Nginx reverse proxy
TRUSTED_PROXIES=127.0.0.1

# ---- Logging --------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

# ---- Production Database (MySQL 8) ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=expertstocks
DB_USERNAME=expertstocks
DB_PASSWORD=YourStrongDatabasePasswordHere

# ---- Production Redis & Queues --------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YourSecureRedisPassword
REDIS_PORT=6379

SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=expertstocks.in
SESSION_COOKIE=esc_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=expertstocks.in,www.expertstocks.in

# ---- Storage & Document Vault ---------------------------------------------
FILESYSTEM_DISK=local
DOCUMENT_DISK=local
DOCUMENT_ENCRYPT_AT_REST=true
DOCUMENT_MAX_SIZE_KB=10240
DOCUMENT_URL_TTL_MINUTES=5

# ---- Mail & Notifications -------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@expertstocks.in
MAIL_PASSWORD=YourSmtpPassword
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@expertstocks.in"
MAIL_FROM_NAME="Expert Stocks Consultancy"

# ---- Frontend Integration -------------------------------------------------
FRONTEND_URL=https://expertstocks.in

# ---- Payment Gateways (Phase 4) -------------------------------------------
PAYMENTS_MANUAL_ENABLED=true
PAYMENTS_CASHFREE_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=PRODUCTION

PAYMENTS_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Market Data Providers (Phase 5) --------------------------------------
MARKET_DATA_DEFAULT_PROVIDER=mock
MARKET_DATA_STALE_THRESHOLD_SECONDS=900

# ---- AI Intelligence Engine (Phase 6) -------------------------------------
AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_ENFORCE_GROUNDING=true
AI_BLOCK_UNGROUNDED_NUMBERS=true
