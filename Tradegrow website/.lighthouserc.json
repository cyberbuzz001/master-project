{
  "_README": [
    "Lighthouse CI config. Run locally:  npx @lhci/cli@0.14.x autorun",
    "Uses the project's own dev server on port 4399 so it does not clash with the",
    "default 4321 a developer may already have running.",
    "IMPORTANT: build WITHOUT BASE_PATH before running. A subpath build emits",
    "/webtradegrow/... links, which a server rooted at dist/ cannot resolve."
  ],
  "ci": {
    "collect": {
      "startServerCommand": "node build/build.js --serve --port 4399",
      "startServerReadyPattern": "Dev server",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4399/",
        "http://localhost:4399/verify/",
        "http://localhost:4399/pricing/",
        "http://localhost:4399/platform/",
        "http://localhost:4399/open-account/",
        "http://localhost:4399/faq/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
        "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "pessimistic" }],
        "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "pessimistic" }],

        "color-contrast": "error",
        "definition-list": "error",
        "label-content-name-mismatch": "error",
        "heading-order": "error",
        "html-has-lang": "error",
        "link-name": "error",
        "button-name": "error",
        "label": "error",
        "image-alt": "error",
        "duplicate-id-aria": "error",

        "uses-text-compression": "off",
        "uses-long-cache-ttl": "off",
        "unminified-css": "off",
        "unminified-javascript": "off",
        "unused-css-rules": "off",
        "render-blocking-resources": "off",
        "csp-xss": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
