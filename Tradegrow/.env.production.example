# ============================================================
# STOCKSHARP BROKERAGE SIMULATION PLATFORM — PRODUCTION ENV TEMPLATE
# ============================================================

# PORT & SYSTEM CONFIGURATION
PORT=5000
NODE_ENV=production
# CRITICAL SECURITY: Replace with a strong, randomly generated string (32+ chars)
JWT_SECRET=change_this_to_a_secure_random_32_character_jwt_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_secure_random_32_character_refresh_secret_in_production

# SAFETY HARDFLAG — MUST REMAIN false AT ALL TIMES (PAPER TRADING ONLY)
REAL_MONEY_TRADING=false

# DEFAULT VIRTUAL CAPITAL ALLOCATION (INR)
DEFAULT_VIRTUAL_CAPITAL=1000000

# MARKET DATA PROVIDER CONFIGURATION
# Options: ANGELONE | DHAN | TRUEDATA | ALPHAVANTAGE | INDIAN_STOCK_MARKET_API | MOCK_ENGINE
PRIMARY_MARKET_DATA_PROVIDER=ANGELONE

# ANGEL ONE SMARTAPI KEYS (MARKET DATA ONLY)
ANGELONE_API_KEY=your_angel_one_api_key
ANGELONE_CLIENT_ID=your_angel_one_client_id
ANGELONE_CLIENT_SECRET=your_angel_one_client_secret
ANGELONE_TOTP_SECRET=your_angel_one_totp_secret

# ALPHA VANTAGE KEYS (GLOBAL DATA / CANDLES)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key

# AI SUPPORT BOT (Live Chat) — leave unset to disable the auto-reply feature entirely
ANTHROPIC_API_KEY=your_anthropic_api_key

# ORDER SESSION GATE — blocks order placement outside market hours (equity 9:15-15:30 IST,
# MCX 9:00-23:30 IST, Mon-Fri). Set to false ONLY for testing/demos.
ENFORCE_MARKET_HOURS=true

# POSTGRESQL DATABASE CONFIGURATION
# Option 1: Full Connection String
DATABASE_URL=postgresql://stocksharp:your_db_password@postgres:5432/stocksharp?schema=public

# Option 2: Individual Connection Variables
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=stocksharp
PG_USER=stocksharp
PG_PASSWORD=your_db_password
PG_POOL_MAX=20

# REDIS CONFIGURATION
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# CORS ALLOWED ORIGINS (Comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5000
