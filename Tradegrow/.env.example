# PORT & SYSTEM CONFIGURATION
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_paper_trading_platform_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_paper_trading_2026

# CRITICAL SAFETY SWITCH — DO NOT MODIFY
REAL_MONEY_TRADING=false

# DEFAULT VIRTUAL MONEY ALLOCATION (INR)
DEFAULT_VIRTUAL_CAPITAL=1000000

# ANGEL ONE SMARTAPI MARKET DATA PROVIDER CONFIGURATION (MARKET DATA ONLY)
ANGELONE_API_KEY=your_api_key
ANGELONE_CLIENT_ID=your_client_code
ANGELONE_CLIENT_SECRET=your_password
ANGELONE_TOTP_SECRET=your_totp_secret

SMARTAPI_API_KEY=your_api_key
SMARTAPI_CLIENT_CODE=your_client_code
SMARTAPI_PASSWORD=your_password
SMARTAPI_TOTP_SECRET=your_totp_secret

# FYERS API V3 MARKET DATA PROVIDER CONFIGURATION
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_ACCESS_TOKEN=your_fyers_access_token
FYERS_REDIRECT_URI=http://localhost:5000/api/v1/auth/fyers/callback

# DHAN HQ API V2 MARKET DATA & BROKER CONFIGURATION
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_API_KEY=your_dhan_api_key
DHAN_API_SECRET=your_dhan_api_secret

# MARKET DATA PRIMARY PROVIDER [DHAN | FYERS | ANGELONE | MOCK_ENGINE]
PRIMARY_MARKET_DATA_PROVIDER=DHAN

# AI SUPPORT BOT (Live Chat) — leave unset to disable the auto-reply feature entirely
ANTHROPIC_API_KEY=your_anthropic_api_key

# ORDER SESSION GATE — blocks order placement outside market hours (equity 9:15-15:30 IST,
# MCX 9:00-23:30 IST, Mon-Fri). Set to false ONLY for testing/demos.
ENFORCE_MARKET_HOURS=true
