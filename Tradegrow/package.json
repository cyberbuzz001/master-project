{
  "name": "stocksharp-brokerage-simulation",
  "version": "1.0.0",
  "description": "Production-Ready Multi-User Brokerage Simulation & Paper Trading Platform",
  "main": "server/dist/index.js",
  "scripts": {
    "init-db": "node -e \"require('./server/dist/db/init.js').seedDatabase().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1);})\"",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node server/dist/index.js",
    "dev:server": "ts-node-dev --max-old-space-size=4096 --project server/tsconfig.json --respawn --transpile-only server/src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev:python": "cd python_engine && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:python\"",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^5.1.1",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "uuid": "^14.0.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^9.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
